# Funda360 marketing website configuration.
# Copy to .env.local for local development. All values are public (NEXT_PUBLIC_*)
# because they are embedded into the static site. Never put secrets here.

# Canonical origin of this marketing site. Used for canonical URLs, Open Graph,
# sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.funda360.example

# Where the "Login" CTA sends people: the existing Funda360 application.
# The marketing site never authenticates users itself.
NEXT_PUBLIC_APP_LOGIN_URL=https://app.funda360.aurisnexus.co.za/login

# Public URL of the deployed Request a Demo endpoint (server/demo-request).
# Not a secret. Leave empty until the endpoint is deployed: the form then says
# up front that online submission is not connected and only validates.
# Local end-to-end testing: http://localhost:8787 (npm run demo-endpoint).
NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT=
# Optional Cloudflare Turnstile site key (public). Pair with TURNSTILE_SECRET_KEY on the endpoint.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# CONFIRM before setting: public contact address offered if online submission fails.
NEXT_PUBLIC_CONTACT_EMAIL=

# Search engine ownership verification (HTML tag method). Rendered only on
# indexable production builds. Not needed with DNS verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Endpoint secrets (RESEND_API_KEY, DEMO_REQUEST_WEBHOOK_URL, DEMO_REQUEST_WEBHOOK_SECRET,
# TURNSTILE_SECRET_KEY) belong to the endpoint host only, never in this file.
# See server/demo-request/README.md.

# Search-engine indexing. Keep "false" for previews/staging; set to "true"
# only on the production marketing domain. Indexing also requires
# NEXT_PUBLIC_SITE_URL to be a public https origin.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Draft articles: listed on non-indexed previews, hidden when indexing is on.
# Set true/false to override.
# NEXT_PUBLIC_SHOW_DRAFT_CONTENT=

# CONFIRM before setting. Used only in Organization structured data.
# Leave empty until the official URLs are confirmed. Never guess.
NEXT_PUBLIC_DEVELOPER_URL=
# Comma-separated, verified social profile URLs (schema.org sameAs).
NEXT_PUBLIC_SOCIAL_PROFILES=
