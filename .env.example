# Funda360 marketing website configuration.
# Copy to .env.local for local development. All values are public (NEXT_PUBLIC_*)
# because they are embedded into the static site. Never put secrets here.

# Canonical origin of this marketing site. Used for canonical URLs, Open Graph,
# sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.funda360.example

# Where the "Login" CTA sends people: the existing Funda360 application.
# The marketing site never authenticates users itself.
NEXT_PUBLIC_APP_LOGIN_URL=https://funda360.aurisnexus.co.za/login

# Request a Demo submission endpoint (Phase 1 integration boundary).
# Leave empty until a backend (CRM, form service, Edge Function) is chosen.
# When empty, the form validates but tells the user submission is not yet connected.
NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT=

# Search-engine indexing. Keep "false" for previews/staging; set to "true"
# only on the production marketing domain at launch.
NEXT_PUBLIC_ALLOW_INDEXING=false
